<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet id="create_users" author="tabletka97">
        <createTable tableName="users">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="surname" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="birth_date" type="date"/>
            <column name="email" type="varchar">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="varchar"/>
            <column name="createdAt" type="datetime2"/>
            <column name="updatedAt" type="datetime2"/>
        </createTable>
    </changeSet>

    <changeSet id="adding_email_index" author="tabletka97">
        <createIndex tableName="users" indexName="idx_email" unique="true">
            <column name="email"/>
        </createIndex>
    </changeSet>
    
    <changeSet id="renaming_users_date_columns" author="tabletka97">
        <renameColumn tableName="users" oldColumnName="createdAt"
                      newColumnName="created_at"/>
        <renameColumn tableName="users" oldColumnName="updatedAt"
                      newColumnName="updated_at"/>
    </changeSet>

    <changeSet id="users_active_datatype_change" author="tabletka97">
        <modifyDataType tableName="users" columnName="active"
                        newDataType="boolean"/>
    </changeSet>

</databaseChangeLog>